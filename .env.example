# Copy this file to .env and fill in the values. NEVER commit .env.

PORT=3000
APP_URL=http://localhost:3000

# --- Auth0 (public values, safe to share) ---
AUTH0_DOMAIN=shieldnex.eu.auth0.com
AUTH0_SPA_CLIENT_ID=RXNj9ZdARAl2GeXkByG0qzUDB4ZClaCq
AUTH0_DB_CONNECTION=Username-Password-Authentication

# --- Auth0 "ShieldNex API" machine-to-machine app (SECRET) ---
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- MongoDB Atlas connection string (SECRET) ---
MONGODB_URI=

# --- Long random string used to sign reset tokens and hash OTPs (SECRET) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RESET_TOKEN_SECRET=

# --- SMTP for sending OTP emails (SECRET) ---
# Zoho:      smtp.zoho.in (India accounts) / smtp.zoho.com, port 465, secure=true
# Hostinger: smtp.hostinger.com, port 465, secure=true
# Brevo:     smtp-relay.brevo.com, port 587, secure=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShieldNex <no-reply@sanatanup.in>"

# --- Cloudflare Turnstile CAPTCHA ---
# These are Cloudflare's official TEST keys (always pass). Replace with real keys before going live.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Phone numbers entered without a country code get this prefix
DEFAULT_COUNTRY_CODE=+91
